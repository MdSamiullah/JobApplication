\NewExpandableDocumentCommand \__makelabels_Ifkomavarempty { s m m m }
  {
    \IfBooleanTF { #1 }
      {
        \exp_args:Nc \__makelabels_if_empty_var_or_name:NTF{scr@#2@name}{#3}{#4}
